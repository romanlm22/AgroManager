# Copiá este archivo como ".env" y completá los valores. ".env" está en .gitignore: no se sube al repo.

# Contraseña de PostgreSQL (elegí una larga y única).
POSTGRES_PASSWORD=

# Secreto con el que se firman los JWT. Generalo con:  openssl rand -base64 64
JWT_SECRET=

# Opcional: API key de Google Gemini para el asistente. Sin ella el asistente responde 503.
GEMINI_API_KEY=

# Opcional: solo si el frontend se sirve desde otro origen que la API.
CORS_ALLOWED_ORIGINS=

# Puerto en el que se publica la aplicación (por defecto 80).
HTTP_PORT=80
